# Razorpay credentials — get test keys from the Razorpay dashboard:
# Settings > API Keys > Generate Test Key
#
# RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET are used server-side only
# (src/lib/razorpay.server.ts) to create orders and verify payment signatures.
# key_secret must NEVER be prefixed with VITE_ or referenced from client code.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# The same key_id, exposed to the browser so the Razorpay Checkout widget can
# open (this is safe to expose — it's a publishable identifier, not a secret).
# Vite only exposes env vars prefixed with VITE_ to client code.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Google Places API — powers the live "Customer reviews" section on the
# homepage. Create an API key in Google Cloud Console with the "Places API
# (New)" enabled, and find your Place ID at
# https://developers.google.com/maps/documentation/places/web-service/place-id
# Without these, the reviews section shows a "not connected yet" placeholder.
GOOGLE_PLACE_ID=your_google_business_place_id
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Supabase public/publishable browser credentials
# Use the project URL and the publishable (anon) key from Supabase Project Settings > API.
# Never put the service-role/secret key in VITE_* variables or browser code.
VITE_SUPABASE_URL=https://nyigmtugjsktzkietgbc.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key

# --- Admin dashboard -----------------------------------------------------
# These are SERVER-ONLY and are used exclusively in src/lib/admin.server.ts.
# None of them may ever be prefixed with VITE_ — that would ship the secret
# to every visitor's browser.
#
# Same project URL as above, but read server-side.
SUPABASE_URL=https://nyigmtugjsktzkietgbc.supabase.co
# Project Settings > API > service_role secret. Bypasses RLS — treat like a
# database password. Rotate it if it ever leaks.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# The password the shop owner types to sign in.
ADMIN_PASSWORD=choose_a_strong_password
# Any long random string (e.g. `openssl rand -hex 32`). Used to sign the
# short-lived admin session token. Changing it signs everyone out.
ADMIN_SESSION_SECRET=generate_a_long_random_string
# The admin dashboard is NOT at /admin — that's too easy to guess/scan for.
# It lives at /manage/<this value>, e.g. /manage/qNySgAPHnX_xtHrlZ0fSu6ns.
# A wrong or missing token at that URL is an ordinary 404, not a login page,
# so there's nothing for a bot scanning common paths to even find. Generate
# your own with `openssl rand -base64 18` (or similar) — don't reuse the
# example below — and bookmark the full URL rather than linking it anywhere
# on the public site. Changing this later instantly retires the old link.
ADMIN_URL_TOKEN=generate_a_long_random_string
